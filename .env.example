# PostgreSQL connection string. Use a local database or a managed Postgres URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public base URL of this app. For local development:
BETTER_AUTH_URL=http://localhost:3000

# Needed only for the Gemini assistant feature.
GEMINI_API_KEY=
